def getSum(limit):
    sum = 0
    for i in range(1, limit + 1):
        sum += i
    return sum

while True:
    try:
        age = int(input("Hi there! Please enter your age: "))
        if age <= 0:
            print("Invalid input.")
            print("Please enter a positive whole number greater than 0.")
            print()
        else:
            expected_sum = age * (age + 1) // 2
            actual_sum = getSum(age)

            print("Expected sum is", expected_sum)
            print("After calling the function getSum, the sum of all numbers from 1 to", age, "is", actual_sum)

            if actual_sum == expected_sum:
                print("Output verified.")

            else:
              print("Output is incorrect.")

            break
          
    except:
        print("Invalid input.")
        print("Please enter a positive whole number greater than 0.")
        print()
